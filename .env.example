# ============================================
# ПРИЛОЖЕНИЕ
# ============================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-your-own-secret-key-here

# ============================================
# MONGODB
# ============================================
MONGODB_URI=mongodb+srv://your-cluster.mongodb.net/nutri-healthy

# ============================================
# EMAIL (RESEND)
# ============================================
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=noreply@yoursite.ru
EMAIL_TO=info@yoursite.ru

# ============================================
# ЮKASSA
# ============================================
# Shop ID (замените на ваш)
YOOKASSA_SHOP_ID=your-shop-id

# Secret SDK (замените на ваш)
# Для тестового режима используйте ключ с префиксом "test_"
YOOKASSA_SECRET_KEY=your-secret-key

# Return URL
YOOKASSA_RETURN_URL=http://localhost:3000/payment/success

# Webhook Secret Key для проверки подписи уведомлений
# Получите в личном кабинете ЮKassa: Настройки → HTTP-уведомления
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# PAYKEEPER
# ============================================
PAYKEEPER_SHOP_ID=your-shop-id
PAYKEEPER_API_TOKEN=your-api-token
PAYKEEPER_RETURN_URL=http://localhost:3000/payment/success
PAYKEEPER_TEST_MODE=true

# ============================================
# АНАЛИТИКА
# ============================================
NEXT_PUBLIC_YANDEX_METRICA_ID=your-metrica-id

# ============================================
# РЕКВИЗИТЫ ИП (для подстановки в legal-документы)
# ============================================
# Подставляются в Markdown через шаблоны {{BUSINESS_*}}
# и используются в footer, email-шаблонах, страницах оплаты.
# Префикс NEXT_PUBLIC_ нужен для использования в Client Component'ах —
# реквизиты публичны и так выводятся в HTML страниц.
NEXT_PUBLIC_BUSINESS_FULL_NAME="ИП Каменская Ксения Александровна"
NEXT_PUBLIC_BUSINESS_INN=
NEXT_PUBLIC_BUSINESS_OGRNIP=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_DOMAIN=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# Регистрационный номер в Реестре операторов ПДн Роскомнадзора (ст. 22 ФЗ-152).
# Оставьте пустым, если уведомление ещё не подано — на странице оператора
# будет показан соответствующий статус.
NEXT_PUBLIC_BUSINESS_RKN_REG_NUMBER=

# ============================================
# ЮРИДИЧЕСКИЕ ДОКУМЕНТЫ (версии)
# ============================================
PRIVACY_POLICY_VERSION=3.0
CONTRACT_VERSION=3.0
PERSONAL_DATA_CONSENT_VERSION=3.0
HEALTH_DATA_CONSENT_VERSION=1.0
CROSS_BORDER_CONSENT_VERSION=1.0
MARKETING_CONSENT_VERSION=3.0
COOKIES_CONSENT_VERSION=1.0
RETURN_POLICY_VERSION=3.0
DELIVERY_TERMS_VERSION=3.0
OPERATOR_NOTIFICATION_VERSION=1.0
